# ─── LinkedIn App Credentials ───────────────────────────────────────────────
# Get these from: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# ─── Server ──────────────────────────────────────────────────────────────────
# Your server's public URL (no trailing slash)
# For EC2: http://YOUR_EC2_IP:3000  OR  https://yourdomain.com
BASE_URL=http://localhost:3000

# Port to listen on
PORT=3000

# ─── MCP Security ────────────────────────────────────────────────────────────
# Secret key your AI agent uses to authenticate with the MCP server
# Generate with: openssl rand -hex 32
MCP_SECRET_KEY=generate-a-strong-random-key-here
